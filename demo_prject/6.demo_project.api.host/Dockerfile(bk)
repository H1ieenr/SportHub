#See https://aka.ms/customizecontainer to learn how to customize your debug container and how Visual Studio uses this Dockerfile to build your images for faster debugging.

FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS base
WORKDIR /app
EXPOSE 80
EXPOSE 443

FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
ARG BUILD_CONFIGURATION=Release
WORKDIR /src
COPY ["demo_project/6.demo_project.api.host/6.demo_project.api.host.csproj", "demo_project/6.demo_project.api.host/"]
COPY ["library/azicloud.extension.dependencyinjection/azicloud.extension.dependencyinjection.csproj", "library/azicloud.extension.dependencyinjection/"]
COPY ["library/azicloud.library.shared/azicloud.library.shared.csproj", "library/azicloud.library.shared/"]
COPY ["library/azicloud.library/azicloud.library.csproj", "library/azicloud.library/"]
COPY ["demo_project/1.demo_project.repository/1.demo_project.repository.csproj", "demo_project/1.demo_project.repository/"]
COPY ["library/azicloud.database/azicloud.database.csproj", "library/azicloud.database/"]
COPY ["library/azicloud.domain/azicloud.domain.csproj", "library/azicloud.domain/"]
COPY ["library/azicloud.repository/azicloud.repository.csproj", "library/azicloud.repository/"]
COPY ["library/azicloud.common/azicloud.common.csproj", "library/azicloud.common/"]
COPY ["demo_project/0.demo_project.shared/0.demo_project.shared.csproj", "demo_project/0.demo_project.shared/"]
COPY ["demo_project/2.demo_project.domain/2.demo_project.domain.csproj", "demo_project/2.demo_project.domain/"]
COPY ["demo_project/3.demo_project.app/3.demo_project.app.csproj", "demo_project/3.demo_project.app/"]
COPY ["library/azicloud.grpc.client/azicloud.grpc.client.csproj", "library/azicloud.grpc.client/"]
COPY ["library/azicloud.notification/azicloud.notification.csproj", "library/azicloud.notification/"]
COPY ["demo_project/4.demo_project.app.contracts/4.demo_project.app.contracts.csproj", "demo_project/4.demo_project.app.contracts/"]
COPY ["azitask/azicloud.queue/azicloud.queue.csproj", "azitask/azicloud.queue/"]
COPY ["library/azicloud.cache/azicloud.cache.csproj", "library/azicloud.cache/"]
COPY ["demo_project/5.demo_project.api/5.demo_project.api.csproj", "demo_project/5.demo_project.api/"]
COPY ["library/azicloud.api/azicloud.api.csproj", "library/azicloud.api/"]
COPY ["library/azicloud.app.contracts/azicloud.app.contracts.csproj", "library/azicloud.app.contracts/"]
RUN dotnet restore "./demo_project/6.demo_project.api.host/./6.demo_project.api.host.csproj"
COPY . .
WORKDIR "/src/demo_project/6.demo_project.api.host"
RUN dotnet build "./6.demo_project.api.host.csproj" -c $BUILD_CONFIGURATION -o /app/build

FROM build AS publish
ARG BUILD_CONFIGURATION=Release
RUN dotnet publish "./6.demo_project.api.host.csproj" -c $BUILD_CONFIGURATION -o /app/publish /p:UseAppHost=false

FROM base AS final
WORKDIR /app
COPY --from=publish /app/publish .
ENTRYPOINT ["dotnet", "6.demo_project.api.host.dll"]